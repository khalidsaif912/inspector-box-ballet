rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function okStr(v) { return v is string && v.size() < 80; }
    function isAdmin() { return request.auth != null && request.auth.token.email == 'admin@game1.app'; }
    // تقدّم الموظف (اختياري): xp الخبرة، rank معرّف الرتبة، dgr شهادة المواد الخطرة 0/1، dgrBest أطول سلسلة صحيحة
    function okProgress(d) {
      return (!('xp' in d) || (d.xp is int && d.xp >= 0 && d.xp <= 1000000))
        && (!('rank' in d) || (d.rank is string && d.rank.size() < 24))
        && (!('dgr' in d) || d.dgr in [0, 1])
        && (!('dgrBest' in d) || (d.dgrBest is int && d.dgrBest >= 0 && d.dgrBest <= 100000));
    }
    match /players/{id} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['id','name','dept','best','plays','logins','last','xp','rank','dgr','dgrBest'])
        && okStr(request.resource.data.name) && request.resource.data.best is int
        && request.resource.data.best >= 0 && request.resource.data.best <= 100000
        && okProgress(request.resource.data);
      allow delete: if isAdmin();
    }
    match /logins/{doc} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['id','name','dept','at']) && okStr(request.resource.data.name);
      allow update: if false;
      allow delete: if isAdmin();
    }
    // أسئلة المفتش: تقرؤها اللعبة، ويضيفها/يعدّلها/يحذفها المدير فقط من صفحة الإدارة.
    // الصورة data URL مضغوطة (أقل من 400 ألف حرف)، والمستند _meta يعني أن المدير اعتمد القائمة.
    function txt(v, n) { return v is string && v.size() <= n; }
    function okQuestion(d) {
      return d.keys().hasOnly(['id','q','qEn','a1','a2','a3','a1En','a2En','a3En','img','on','ord','at'])
        && txt(d.q, 300) && d.q.size() > 0 && txt(d.qEn, 300)
        && txt(d.a1, 120) && d.a1.size() > 0 && txt(d.a2, 120) && d.a2.size() > 0 && txt(d.a3, 120)
        && txt(d.a1En, 120) && txt(d.a2En, 120) && txt(d.a3En, 120)
        && txt(d.img, 400000) && d.on in [0, 1] && d.ord is int;
    }
    match /questions/{id} {
      allow read: if true;
      allow create, update: if isAdmin() && (id == '_meta' ? request.resource.data.keys().hasOnly(['seeded','at']) : okQuestion(request.resource.data));
      allow delete: if isAdmin();
    }
    match /scores/{doc} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['id','name','dept','score','at'])
        && request.resource.data.score is int && request.resource.data.score >= 0 && request.resource.data.score <= 100000;
      allow update: if false;
      allow delete: if isAdmin();
    }
  }
}
