rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function okStr(v) { return v is string && v.size() < 80; }
    match /players/{id} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['id','name','dept','best','plays','logins','last'])
        && okStr(request.resource.data.name) && request.resource.data.best is int
        && request.resource.data.best >= 0 && request.resource.data.best <= 100000;
      allow delete: if false;
    }
    match /logins/{doc} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['id','name','dept','at']) && okStr(request.resource.data.name);
      allow update, delete: if false;
    }
    match /scores/{doc} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['id','name','dept','score','at'])
        && request.resource.data.score is int && request.resource.data.score >= 0 && request.resource.data.score <= 100000;
      allow update, delete: if false;
    }
  }
}
